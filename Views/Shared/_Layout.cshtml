<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Visualizate</title>

    <!-- CSS de la plantilla -->
    <link rel="stylesheet" href="~/2117_infinite_loop/fontawesome-5.5/css/all.min.css" />
    <link rel="stylesheet" href="~/2117_infinite_loop/slick/slick.css" />
    <link rel="stylesheet" href="~/2117_infinite_loop/slick/slick-theme.css" />
    <link rel="stylesheet" href="~/2117_infinite_loop/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/2117_infinite_loop/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/2117_infinite_loop/css/tooplate-infinite-loop.css" />

    <!-- CSS propio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @RenderBody()

    <!-- JavaScript -->
    <script src="~/2117_infinite_loop/js/jquery-1.9.1.min.js"></script>
    <script src="~/2117_infinite_loop/js/bootstrap.min.js"></script>
    <script src="~/2117_infinite_loop/slick/slick.min.js"></script>
    <script src="~/2117_infinite_loop/magnific-popup/jquery.magnific-popup.min.js"></script>
    <script src="~/2117_infinite_loop/js/easing.min.js"></script>
    <script src="~/2117_infinite_loop/js/jquery.singlePageNav.min.js"></script>
    <script src="~/2117_infinite_loop/js/tooplate-infinite-loop.js"></script>

    <!-- Scripts propios -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>